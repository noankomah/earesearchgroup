# Local development: export these values in your terminal before manage.py commands.
# On OVH use /etc/earg.env, loaded by the supplied systemd service.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.org,www.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org
# Enable only behind the supplied Nginx proxy, with Gunicorn bound to localhost.
DJANGO_TRUST_PROXY_IP=1
POSTGRES_DB=earg
POSTGRES_USER=earg
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
